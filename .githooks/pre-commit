#!/bin/bash
# Pre-commit hook: witness lines and native lint selected from the staged diff;
# no tests run (they run only when the owner explicitly asks).
# Install: git config core.hooksPath .githooks (done by make setup)

set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

[ -f "go.mod" ] || exit 0

exec "$ROOT/scripts/check-changed.sh"
