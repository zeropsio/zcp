#!/bin/bash
# Pre-push hook: static witness and drop-trailer checks per pushed range; no
# tests run. Native lint runs once in pre-commit; CI runs lint, vet and build.
# Install: git config core.hooksPath .githooks (done by make setup)

# Worktrees share one hooks directory; a checkout from before the witness rule has no script.
CHECK="$(git rev-parse --show-toplevel)/scripts/witness-check.sh"
[ -x "$CHECK" ] || exit 0
exec "$CHECK"
