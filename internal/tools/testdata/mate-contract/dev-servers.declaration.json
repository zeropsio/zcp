{
  "version": 1,
  "servers": [
    {
      "name": "web",
      "port": 3000,
      "command": "bun --watch index.ts",
      "cwd": "apps/web"
    },
    {
      "name": "api",
      "port": 8080,
      "command": "go build -o app . && exec ./app",
      "cwd": "apps/api",
      "watch": {
        "paths": [
          "apps/api"
        ],
        "ignore": [
          "apps/api/app"
        ]
      }
    },
    {
      "name": "worker",
      "command": "bun --watch src/worker.ts",
      "cwd": "apps/worker"
    }
  ]
}
