{
  "name": "zcp-bootstrap",
  "displayName": "ZCP Bootstrap",
  "description": "Agent launcher: opens the chosen Zerops agent on workspace start and from the activity-bar icon",
  "version": "0.1.4",
  "publisher": "zerops",
  "engines": { "vscode": "^1.94.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onView:zcpAgents"],
  "contributes": {
    "commands": [
      { "command": "zerops.welcome", "title": "Zerops: Get Started", "icon": "$(rocket)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "zcpLauncher", "title": "Zerops Agents", "icon": "logo.svg" }
      ]
    },
    "views": {
      "zcpLauncher": [
        { "id": "zcpAgents", "name": "Agents", "type": "webview" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "zerops.welcome", "when": "view == zcpAgents", "group": "navigation" }
      ]
    }
  }
}
