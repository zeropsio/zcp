worker_processes auto;
pid /tmp/nginx.pid;
error_log /var/log/nginx/error.log;

events {
    worker_connections 1024;
}

http {
    access_log /var/log/nginx/access.log;
    client_max_body_size 0;
    map_hash_bucket_size 128;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }
{{- if .HasAuth}}

    map $cookie___zcp_auth $zcp_cookie_ok {
        {{.Password}} 1;
        default 0;
    }
{{- end}}

    server {
        listen 8080;

        port_in_redirect off;
        # Zerops L7 terminates TLS and forwards to us as HTTP. nginx's $scheme
        # would emit Location: http://... breaking iframe loads under the
        # parent dashboard's frame-src https://*.zerops.app CSP. Relative
        # redirects let the browser resolve scheme/host from the address bar.
        absolute_redirect off;
{{- if .HasAuth}}

        location = /zcp-logout {
            # A clear only removes a cookie whose Partitioned attribute matches,
            # so emit both: partitioned (CHIPS jar) + plain (pre-CHIPS jars).
            add_header Set-Cookie "__zcp_auth=; Path=/; HttpOnly; SameSite=None; Secure; Partitioned; Max-Age=0";
            add_header Set-Cookie "__zcp_auth=; Path=/; HttpOnly; SameSite=None; Secure; Max-Age=0";
            return 302 /zcp-login;
        }

        location = /zcp-login {
            default_type text/html;
            return 200 '<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #0f1117; font-family: system-ui, sans-serif; }
  .card { background: #1a1d27; border: 1px solid #2a2d3a; border-radius: 12px; padding: 2rem; width: 100%; max-width: 360px; }
  h1 { color: #fff; font-size: 1.25rem; margin-bottom: 1.5rem; }
  input { width: 100%; padding: 0.65rem 0.85rem; background: #0f1117; border: 1px solid #2a2d3a; border-radius: 8px; color: #fff; font-size: 0.95rem; margin-bottom: 1rem; outline: none; }
  input:focus { border-color: #5865f2; }
  button { width: 100%; padding: 0.65rem; background: #5865f2; border: none; border-radius: 8px; color: #fff; font-size: 0.95rem; cursor: pointer; }
  button:hover { background: #4752c4; }
  .error { color: #f87171; font-size: 0.85rem; margin-top: 0.75rem; }
</style>
</head>
<body>
<div class="card">
  <h1>Login</h1>
  <input type="password" id="token" placeholder="Access token" autofocus />
  <button onclick="login()">Sign in</button>
  <div class="error" id="err"></div>
</div>
<script>
  if (new URLSearchParams(window.location.search).get("invalid") === "1") {
    document.getElementById("err").textContent = "Invalid token.";
  }
  function login() {
    var t = document.getElementById("token").value.trim();
    if (!t) return;
    window.location.href = "/zcp-auth/" + t;
  }
  document.getElementById("token").addEventListener("keydown", function(e) {
    if (e.key === "Enter") login();
  });
</script>
</body>
</html>';
        }

        location = /zcp-auth/{{.Password}} {
            # Partitioned (CHIPS) is load-bearing: the dashboard iframes this
            # host cross-site (app.zerops.io = site zerops.io vs this subdomain
            # = site zerops.app, PSL-listed), so this Set-Cookie is third-party
            # there. Safari ITP + Chromium private modes drop it without
            # Partitioned, looping the embed back to /zcp-login forever.
            # Browsers without CHIPS ignore the attribute and store as before.
            add_header Set-Cookie "__zcp_auth={{.Password}}; Path=/; HttpOnly; SameSite=None; Secure; Partitioned; Max-Age=86400";
            return 302 /;
        }

        location ~ /zcp-auth/ {
            return 302 /zcp-login?invalid=1;
        }
{{- end}}
{{- if .Z3Enabled}}

        # Zerops Code (z3) rides on this origin under {{.Z3BasePath}}/, deliberately
        # OUTSIDE the code-server cookie gate: the z3 server owns its own
        # authentication — a Zerops identity, not this container's shared
        # password — and a browser client has to reach it before it holds any
        # cookie. Rendered whether or not VSCODE_PASSWORD is set, but ONLY when
        # ZCP_Z3_ENABLED is set: with it unset, this location and everything
        # through the readiness route below are absent, and port {{.Z3Port}}
        # stays reachable only through code-server's own proxy door (see below).
        #
        # The TRAILING SLASH on proxy_pass is load-bearing: it strips the prefix,
        # so z3's own routes stay at the loopback root and only the URLs it EMITS
        # carry the prefix (that is what --base-path does). Verified end to end
        # through nginx and the Zerops L7: mint -> token -> ws ticket -> 101.
        location {{.Z3BasePath}}/ {
            proxy_pass http://127.0.0.1:{{.Z3Port}}/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # code-server's own /proxy/<port>/ and /absproxy/<port>/ reach ANY loopback
        # port for whoever holds the container cookie — a second door into z3,
        # authenticated by a shared password instead of a Zerops identity. One
        # door only. A regex location is evaluated before the prefix `location /`
        # that hands requests to code-server, so this closes it there. Rendered
        # only alongside the {{.Z3BasePath}}/ block above: with ZCP_Z3_ENABLED
        # unset, port {{.Z3Port}} is not in use by anything this container runs,
        # and code-server's generic proxy is free to reach it like any other port.
        location ~ ^/(abs)?proxy/{{.Z3Port}}(/|$) {
            return 404;
        }

        # z3's readiness marker, published at {{.Z3BasePath}}/healthz — inside z3's
        # own namespace, not the container's root /healthz, so this route never
        # claims a path code-server (or a future non-z3 use of the root) might
        # want. nginx picks an EXACT match over a prefix location regardless of
        # source order, so `= {{.Z3BasePath}}/healthz` is always served from the
        # static marker below and never reaches the `{{.Z3BasePath}}/` proxy
        # above — it is kept adjacent to that block here purely for readability,
        # not because order matters mechanically.
        #
        # Outside the auth gate on purpose: a client must be able to tell "still
        # initializing" from "broken" before it holds any credential, and must
        # see initAt move to know that a restart re-initialized the container.
        # Serves the marker `zcp init` writes at the end of its step list,
        # verbatim — a static file, so it answers even when every process but
        # nginx is down. z3's own liveness is the SECOND probe
        # ({{.Z3BasePath}}/.well-known/t3/environment answering application/json),
        # never this route: nginx cannot branch a response body on a subrequest,
        # and answering that here would take a process this route exists to avoid.
        location = {{.Z3BasePath}}/healthz {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            # The hosted z3 web client (a different origin) probes this route
            # with a header-less fetch before it holds any credential; the
            # body is a non-secret two-field JSON, so a wide-open allowance
            # is fine.
            add_header Access-Control-Allow-Origin "*" always;
            alias {{.InitMarkerPath}};
            error_page 404 = @zcp_healthz_uninitialized;
        }

        # No marker yet: the first `zcp init` has not finished, or it aborted.
        # Still a parseable answer — a bare 404 would leave a polling client
        # unable to tell "not yet" from "no such route". Exists only alongside
        # the readiness route above, so it too renders only when ZCP_Z3_ENABLED
        # is set.
        location @zcp_healthz_uninitialized {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            add_header Access-Control-Allow-Origin "*" always;
            return 200 '{"initComplete":false,"initAt":null}';
        }
{{- end}}

        location / {
{{- if .HasAuth}}
            if ($zcp_cookie_ok = 0) {
                return 302 /zcp-login;
            }
{{- end}}

            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_hide_header X-Frame-Options;
            add_header Content-Security-Policy "frame-ancestors 'self' https://app.zerops.io https://*.zerops.io https://*.zerops.app https://*.zerops.dev http://localhost:*" always;
        }
    }
}
