{
  "name": "zcp-studio",
  "displayName": "Zerops Managed Data",
  "description": "Browse your Zerops managed-service data (databases, caches, search, object storage, queues) from your editor.",
  "version": "0.1.3",
  "publisher": "zerops",
  "engines": { "vscode": "^1.94.0" },
  "main": "./extension.js",
  "activationEvents": [
    "onView:zcpStudioView",
    "onCommand:zcpStudio.open",
    "onCommand:zcpStudio.openService"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "zcpStudio", "title": "Managed Data", "icon": "media/data.svg" }
      ]
    },
    "views": {
      "zcpStudio": [
        { "id": "zcpStudioView", "name": "Managed Data", "type": "webview", "when": "!isWeb" }
      ]
    },
    "commands": [
      { "command": "zcpStudio.open", "title": "Zerops: Open Data Console", "category": "Zerops" },
      { "command": "zcpStudio.openService", "title": "Zerops: Open Data Console for Service", "category": "Zerops" }
    ]
  }
}
